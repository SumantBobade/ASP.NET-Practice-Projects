@{
    ViewData["Title"] = "Index";
}

<h3>@ViewBag.Message</h3>
<p>Total Customers: @ViewBag.CustomersCount</p>

<ul>
    @foreach(var customer in ViewBag.CustomersList){
        <li>@customer.Id @customer.Name - $@customer.Amount.ToString("F2")</li>
    }
</ul>

@Html.ActionLink("Details Page", "Details", "Customer");